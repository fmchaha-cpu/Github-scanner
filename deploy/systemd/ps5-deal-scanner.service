[Unit]
Description=German PS5 Disc and Digital deal watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=market-scanner
Group=market-scanner
WorkingDirectory=/opt/Github-scanner/collector
EnvironmentFile=/etc/genshin-scanner.env
Environment=PYTHONUNBUFFERED=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
Environment=PS5_STATE_DB=/var/lib/genshin-scanner/ps5-deals.sqlite3
ExecStart=/usr/bin/flock -w 300 /var/lib/genshin-scanner/scan.lock /opt/Github-scanner/.venv/bin/python -m market_v1.ps5_runner --config ps5_sources.yaml
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/genshin-scanner

[Install]
WantedBy=multi-user.target
